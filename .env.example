# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (no trailing slash). Used for SEO, OG, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where "Go to FNJ" / Login in the navbar should point
NEXT_PUBLIC_FNJ_APP_URL=https://fnj.dev

# First admin account. Used by `npm run seed:admin` and auto-promotion on login.
ADMIN_EMAIL=you@fnj.dev
ADMIN_PASSWORD=change-me-to-a-strong-password

# Email notifications for new waitlist signups (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
WAITLIST_NOTIFY_EMAIL=umardesignsin@gmail.com
# Optional. Use a verified domain in production.
# WAITLIST_FROM_EMAIL=FNJ Marketplace <hello@yourdomain.com>
